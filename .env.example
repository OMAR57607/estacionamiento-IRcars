# ---------------------------------------------------------------------------
# Plantilla de configuración. Copie este archivo a `.env` y ajuste los valores.
# NUNCA versione el archivo `.env`: contiene credenciales.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Clave criptográfica de Django. Genere una propia para cada entorno:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambieme-esta-clave-es-solo-para-desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Zona horaria operativa. Determina el corte de día para el tope diario.
DJANGO_TIME_ZONE=America/Mexico_City

# Conexión a PostgreSQL. El host `db` corresponde al servicio de docker-compose.
# Para un PostgreSQL instalado en su equipo use `localhost`.
DATABASE_URL=postgres://ircars:ircars@db:5432/ircars

# Nivel de registro: DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Servicio de boletos (consulta del cliente por código QR)
#
# Arquitectura: la caja local sigue siendo la fuente de verdad. Este servicio
# solo recibe una copia mínima de cada folio —con la placa ya enmascarada— y
# la sirve en una dirección pública. Si se borra por completo, no se pierde
# ningún dato contable.
#
# Detalle en BOLETO-QR.md.
# ---------------------------------------------------------------------------

# Nombre que se muestra en el boleto del cliente.
IRCARS_NOMBRE_COMERCIAL=Estacionamiento IRcars

# Token compartido entre la caja y el servicio. DEBE ser idéntico en ambos
# extremos. Sin valor, la ruta de ingesta responde 503 en lugar de aceptar
# escrituras sin credencial. Genere uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IRCARS_TOKEN_PUBLICACION=

# Origen público del servicio. Es lo que se codifica en el código QR.
IRCARS_URL_BOLETOS=https://boletos.mi-estacionamiento.mx

# Horas que un boleto liquidado sigue consultándose. Mientras el vehículo
# está dentro, el enlace no caduca.
IRCARS_HORAS_VIGENCIA_BOLETO=24

# True si el proceso corre detrás de un proxy que termina el TLS (el caso en
# Railway). De ello depende cómo se determina la IP al aplicar límites de tasa.
IRCARS_TRAS_PROXY=True

# Reduce el despliegue a la consulta e ingesta de boletos: sin panel de
# administración, sin interfaz de caja y sin API del estacionamiento. Es la
# configuración recomendada en la nube.
IRCARS_SOLO_BOLETOS=False

# Solo si ESTA instancia debe publicar los folios que registra. En el servicio
# de la nube va en False.
IRCARS_PUBLICAR_BOLETOS=False

# Permite publicar contra un servicio sin cifrar. SOLO para pruebas locales:
# el token viaja en la petición.
IRCARS_PERMITIR_HTTP_BOLETOS=False
